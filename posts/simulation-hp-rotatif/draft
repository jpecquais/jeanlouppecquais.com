// Inspired by Doppolas cabinet.
doppler_whirl = crossover : ((si.bus(1) <: si.bus(2)) , (_ <: effect_path,dry_path) ) : ((ro.cross2 : +,+),si.bus(2)) : ro.cross2 : +,+ with {
    freq                = hslider("rate",                       1,0.5,10,0.1);
    is_stop             = hslider("stop",                       0,0,1,1);
    mix                 = hslider("effect_mix",                 100,0.,100,0.1)*0.01 : si.smoo;
    freq_tone           = hslider("tone",                       5000,1000,20000,100);
    inertia             = 1.5;//s
    shaft_len           = 20; //cm
    reflections_mix     = 0.5;
    reflections_fdbck   = 0;
    diameter            = 10; // inch
    crossover_fc        = 200; //Hz
    directivity         = 0; // Bipolar speaker
    
    fade_time = (log(freq)-log(0.1))*inertia;
    fade = en.asr(fade_time,1,fade_time,is_stop) : sqrt;
    effect_mix = sqrt(mix)*(1-fade);
    dry_mix = sqrt(1-mix)*(1-fade)+fade;

    crossover = si.bus(1) <: fi.lowpass(1,crossover_fc), fi.highpass(1,crossover_fc);
    splitted_signal = x : crossover;

    low_end  = splitted_signal : _,!;
    high_end = splitted_signal : !,_;
    compensation_filter = correction_filter(diameter,directivity);

    tone_filter = fi.lowpass(1,freq_tone);
    dry_path = si.bus(1)*(dry_mix) <: si.bus(2);
    effect_path = *(effect_mix*7) : fi.highpass(1,6000) : tone_filter : hilbert <: si.bus(4) : (rotary_1,rotary_2) <: (si.bus(2),
                                                                                            ( si.bus(2):>si.bus(1) : *(sqrt(reflections_mix)) : cabinet(reflections_fdbck)))
                                                                                          :  di_dt_panner(6,(0,1,0.20,0.40,0.60,0.80)); 

    analytic_signal = high_end : hilbert;
    rotary_1 = rotative_speaker(freq,is_stop,inertia,directivity,diameter,shaft_len) : compensation_filter;
    rotary_2 = rotative_speaker(freq+0.17,is_stop,inertia,directivity,diameter,shaft_len) : compensation_filter;
};

// Inspired by Yamaha RA-200 cabinet
japan_whirl = crossover : ((si.bus(1) <: si.bus(2)) , (_ <: effect_path,dry_path) ) : ((ro.cross2 : +,+),si.bus(2)) : ro.cross2 : +,+ with {
    freq                = hslider("rate",                       1,0.5,10,0.1);
    is_stop             = hslider("stop",                       0,0,1,1);
    mix                 = hslider("effect_mix",                 100,0.,100,0.1)*0.01 : si.smoo;
    freq_tone           = hslider("tone",                       5000,1000,20000,100);
    inertia             = 2;//s
    shaft_len           = 3; //cm
    reflections_mix     = 0.25;
    reflections_fdbck   = 0.3;
    diameter            = 4; // inch
    crossover_fc        = 900; //Hz
    directivity         = 0; // Bipolar speaker
    
    fade_time = (log(freq)-log(0.1))*inertia;
    fade = en.asr(fade_time,1,fade_time,is_stop) : sqrt;
    effect_mix = sqrt(mix)*(1-fade);
    dry_mix = sqrt(1-mix)*(1-fade)+fade;

    crossover = si.bus(1) <: (fi.lowpass(1,crossover_fc) : fi.lowpass(1,crossover_fc)), (fi.highpass(1,crossover_fc) : fi.highpass(1,crossover_fc) : *(-1));
    splitted_signal = x : crossover;

    low_end  = splitted_signal : _,!;
    high_end = splitted_signal : !,_;
    compensation_filter = correction_filter(diameter,directivity);

    tone_filter = fi.lowpass(1,freq_tone);
    dry_path = si.bus(1)*(dry_mix) <: si.bus(2);
    effect_path =  *(effect_mix*1.414) : tone_filter : compensation_filter :  hilbert <: si.bus(6) :
                    (rotary_1,rotary_2,rotary_3) <: (si.bus(3),
                                                    (si.bus(3):>si.bus(1) : *(sqrt(reflections_mix)) : cabinet(reflections_fdbck))) :
                    di_dt_panner(7,(0,0.5,1,0.20,0.40,0.60,0.80)); 

    analytic_signal = high_end : hilbert;
    rotary_1 = rotative_speaker(freq,is_stop,inertia,directivity,diameter,shaft_len);
    rotary_2 = rotative_speaker(freq+0.17,is_stop,inertia,directivity,diameter,shaft_len);
    rotary_3 = rotative_speaker(freq-0.11,is_stop,inertia,directivity,diameter,shaft_len);
};


