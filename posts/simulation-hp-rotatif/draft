highshelf1(fc,gain_linear) = fi.tf1(b_0,b_1,a_1) with {
    K = 2 * tan(ma.PI * fc * T_S);
    a_0 = 2 + K;
    b_0 = (2*gain_linear+K) / a_0;
    b_1 = (K - 2*gain_linear) / a_0;
    a_1 = (K - 2) / a_0;
};

highshelf2(start_freq,end_freq,gain) = filter(f,q,gain) with {
        f = sqrt(start_freq*end_freq);
        q = f/(end_freq-start_freq);
        // svf hs with db to linear conversion removed.
        filter(F,Q,A) = tick ~ (_,_) : !,!,si.dot(3, mix)
        with {
            tick(ic1eq, ic2eq, v0) =
                2*v1 - ic1eq,
                2*v2 - ic2eq,
                v0, v1, v2
            with {
                v1 = ic1eq + g *(v0-ic2eq) : /(1 + g*(g+k));
                v2 = ic2eq + g * v1;
            };
        g = tan(F * ma.PI/ma.SR) : *(sqrt(A));
        k = 1/Q;
        mix = A*A, k*(1-A)*A, 1-A*A;
    };
};

dual_hs_filter(fc_hs_1,fc_hs_2,lin_gain) = highshelf1(fc_hs_1,lin_gain) : highshelf1(fc_hs_2,lin_gain);

gain_estimator(filter_process, test_freq) = gain_signal with {
        input_sine   = os.osc(test_freq);
        input_cosine = os.osccos(test_freq);
        filtered_out = input_sine : filter_process;
        filtered_out_imag = input_cosine : filter_process;
        gain_signal  = sqrt(pow(filtered_out,2)+pow(filtered_out_imag,2));
};

