/*
Engine to drives a speaker in rotation. Support inertia in frequency changes.
*/
engine(freq,is_stop,inertia) = angular_position with {
    is_turning = 1-is_stop;
    internal_freq = freq*(is_turning) : fi.avg_tau(inertia);
    angular_position = os.lf_sawpos(internal_freq) : *(TWO_PI);
};

directivity_modulation_pattern = case { 
    (0,theta) => abs_(sin_(theta)); // Bipolar type
    (1,theta) => abs_(sin_(0.5 * theta)); // Cardioid type
    (directivity_val,theta) => abs_(sin_(theta));
};

/*
Speaker simulation.
Theta is angle at which the loudspeaker radiate.
Directivity is either 0 or 1. 0 is bidirictionnal mode,
                              1 is cardioid mode.
Diameter is the diameter of the speaker in inch. Affect the directivity dependent filtering.
Shaft Length is the length of shaft that make the speaker rotate. Affect the doppler effect.
Takes an analytic signal as input.
*/
speaker(theta,directivity,diameter,shaft_len,sig_real,sig_imag) = phase_model : directivity_model : doppler_effect with {


    directivity_model = high_attenuation(diameter,directivity) : diffraction with {

        high_attenuation(diameter,directivity) = dual_hs_filter(fc_hs_1,fc_hs_2,0.2) with {
            f_max = 20000;
            
            min_fc_hs_1 = speaker_minimum_cutoff(diameter);
            lfo_hs_1 = directivity_modulation_pattern(directivity,theta);
            fc_hs_1 = f_max * pow(min_fc_hs_1 / f_max, lfo_hs_1);

            min_fc_hs_2 = 3*min_fc_hs_1;
            lfo_hs_2 = 0.5-0.5*cos_(theta);
            fc_hs_2 = f_max * pow(min_fc_hs_2 / f_max, lfo_hs_2);
        };

        comb_b0 = 0.5;
        comb_bM = 0.5;
        dist_smpls = inch_to_samples(diameter)*abs_(sin_(theta));
        diffraction = fi.ff_fcomb(MAX_DELAY_LEN,dist_smpls,comb_b0,comb_bM);

    };

    doppler_effect = de.fdelay1(MAX_DELAY_LEN,delay) with {
        delay = cm_to_samples(2*shaft_len)*(0.5-0.5*cos_(theta));
    };

    phase_model = real_path, imag_path : + with {
        phase_theta(x) = x-0.5*sin_(2*x);
        phase = phase_theta(theta);
        real_path = *(sig_real,cos_(phase));
        imag_path = *(sig_imag,sin_(phase));
    };
};

correction_filter(diameter,directivity) = filter(diameter,directivity) with {

    //Specialization for embedded applications.
    filter(4,0) = tick ~ (_,_) : !,!,si.dot(3, mix) with {
        tick(ic1eq, ic2eq, v0) =
                2*v1 - ic1eq,
                2*v2 - ic2eq,
                v0, v1, v2
            with {
                v1 = (ic1eq + g *(v0-ic2eq)) * 0.6494681400;
                v2 = ic2eq + g * v1;
            };

        g = 0.3570773880;
        k = 1.1546760354;
        mix = 1.999396, -0.6758700264, -0.999396;
    };

    filter(diameter,directivity) = highshelf2(correction_start_freq,correction_end_freq,(correction_target_gain)) with {
        min_fc_hs_1 = speaker_cutoff(ma.PI/4,diameter);
        min_fc_hs_2 = 3*min_fc_hs_1;

        correction_start_freq = min_fc_hs_1;
        correction_end_freq = min_fc_hs_2;

        target_filter(0) = dual_hs_filter(min_fc_hs_1,min_fc_hs_2,0.2);
        target_filter(1) = dual_hs_filter(min_fc_hs_1,min_fc_hs_1,0.2);
        target_filter(directivity) = dual_hs_filter(min_fc_hs_1,min_fc_hs_2,0.2);

        target_frequency = 2*correction_start_freq;
        correction_target_gain = gain_estimator(target_filter(directivity),target_frequency) : sqrt;
    };
};

/*
Association of a speaker and an engine
*/
rotative_speaker(freq,is_stop,inertia,directivity,diameter,shaft_len,sig_real,sig_imag) = speaker(theta,directivity,diameter,shaft_len,sig_real,sig_imag) with {
    theta = engine(freq,is_stop,inertia);
};

/*
Simple pan using both Δi and Δt auditory cues.
*/
di_dt_panner(NUM_SOURCES,(sources_pan)) = panners : mixer with {
    panners = par(i,NUM_SOURCES,panner(ba.selector(i,NUM_SOURCES,sources_pan)));
    panner(pan) = _ <: (*(pan_l) : @(int(del*pan_l))),
                       (*(pan_r) : @(int(del*pan_r))) with {
        del = cm_to_samples(17);
        pan_l = sqrt(1-pan);
        pan_r = sqrt(pan);
    };
    mixer = si.bus(2*NUM_SOURCES) <: ((par(i,NUM_SOURCES,(_,!)):>si.bus(1)) ,(par(i,NUM_SOURCES,(!,_)):>si.bus(1)));
};

/*
Simple cabinet reflections using four parallel delay lines summed in feedback path.
The feedback path also include an allpass diffusor to add density.
*/
cabinet(feedback) = fi.highpass(1,400) : diffusor with {
    diffusor = si.bus(1) : *(0.707) : delay_lines~loop : si.bus(4) with {
        delay_lines = + : fi.lowpass(1,3000) <: @(179),
                                                @(257),
                                                @(373),
                                                @(547);
        loop = si.bus(4) :> *(feedback*0.25) : fi.allpass_comb(1024,701,0.5);
    };
};


